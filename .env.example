# Copy this file to .env.local and fill in your own values:
#   cp .env.example .env.local
# Find them in Supabase: Project Settings -> API.
# .env.local is git-ignored, so your real keys never get committed.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Never put the service_role key in a NEXT_PUBLIC_ variable —
# anything prefixed NEXT_PUBLIC_ is shipped to every visitor's browser.
